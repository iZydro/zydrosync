
# --- ZydroSync (añadido por zydro-ios/server/deploy/deploy.sh) ---
__DOMAIN__ {
	# Las carreras llegan comprimidas; el servidor rechaza más de 10 MB igualmente.
	request_body {
		max_size 10MB
	}
	header Strict-Transport-Security "max-age=31536000"
	# /admin: el panel se sirve (HTML y JS); su API exige sesión de administrador de
	# ZydroLogin. Los tokens admin (zsa_) solo valen por el túnel SSH.
	reverse_proxy zydrosync:8080
}
# --- fin ZydroSync ---
