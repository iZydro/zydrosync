{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataDirectory": "data"
  },
  "Ingest": {
    "MaxRequestBytes": 10485760,
    "MaxJsonBytes": 20971520
  },
  "RateLimit": {
    "PerMinute": 120
  },
  "Admin": {
    "Enabled": false
  }
}
